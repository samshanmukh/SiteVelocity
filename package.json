{
  "name": "sitevelocity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/contracts/**/*.test.ts\"",
    "test:integration": "node --conditions=react-server --import tsx --test \"tests/integration/**/*.test.ts\"",
    "test:contracts": "node scripts/test-contracts.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts",
    "workflow:start": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/workflow-entrypoint.ts",
    "deployment:check": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/deployment-check.ts",
    "pdd:check": "bash scripts/pdd-check.sh",
    "pdd:stories": "node scripts/validate-pdd-user-stories.mjs",
    "pdd:estimate": "bash scripts/pdd-estimate.sh",
    "ingest": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/ingest-candidates.ts",
    "ingest:schedule": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/schedule-candidate-ingestion.ts",
    "tenant:bootstrap": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/bootstrap-live-tenant.ts",
    "research": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/run-research.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > lib/persistence/database.types.ts",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked"
  },
  "dependencies": {
    "@renderinc/sdk": "0.6.0",
    "@supabase/supabase-js": "2.110.8",
    "@turf/turf": "7.3.4",
    "mapbox-gl": "^3.27.0",
    "maplibre-gl": "5.19.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rocketride": "^1.3.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.27",
    "eslint": "^9.0.0",
    "jsdom": "28.1.0",
    "playwright": "1.58.2",
    "postcss": "8.5.23",
    "supabase": "^2.109.1",
    "tailwindcss": "3.4.19",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8"
  }
}
