U2: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U2; tests/contracts/alpha_application_ui.contract.test.ts :: R3
U3: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U3; tests/e2e/a11y.spec.ts
U4: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U4; tests/e2e/a11y.spec.ts
U5: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U5; tests/e2e/a11y.spec.ts
U6: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U6; tests/contracts/alpha_application_ui.contract.test.ts :: R20/U6
U7: tests/contracts/sitevelocity_ui_standards.coverage.test.ts :: U7; tests/contracts/alpha_application_ui.contract.test.ts :: R19/U7
